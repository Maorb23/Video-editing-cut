*.py[cod]
*$py.class

# Python environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# Test, coverage, type-checker, and linter caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# Runtime logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~
service-data/

# Interrupted video renders and atomic-write staging files
*.partial.mp4
.*.partial.mp4
.*.tmp

# Local environment and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local Codex/agent runtime state
.agents/

