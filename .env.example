# Core API and worker
VIDEO_EDIT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/video_editing
# Railway's Postgres plugin can provide DATABASE_URL instead.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
VIDEO_EDIT_DJANGO_SECRET_KEY=replace-with-a-long-random-secret
VIDEO_EDIT_STORAGE=filesystem
VIDEO_EDIT_STORAGE_ROOT=./service-data/objects
VIDEO_EDIT_WORK_ROOT=./service-data/jobs
VIDEO_EDIT_SESSION_COOKIE_SECURE=false
# Phone-video silence preflight defaults
VIDEO_EDIT_MINIMUM_SILENCE_SECONDS=0.25
VIDEO_EDIT_SPEECH_PADDING_SECONDS=0.12
VIDEO_EDIT_SILENCE_THRESHOLD_MIN_DB=-60
VIDEO_EDIT_SILENCE_THRESHOLD_MAX_DB=-30
VIDEO_EDIT_SILENCE_CALIBRATION_MARGIN_DB=8
VIDEO_EDIT_SILENCE_FALLBACK_THRESHOLD_DB=-50

# OpenAI planning (set on the worker service; seal this variable in Railway)
OPENAI_API_KEY=
VIDEO_EDIT_MODEL=gpt-5.6

# SaaS account services
MELVID_PUBLIC_BASE_URL=http://127.0.0.1:8000
MELVID_TURNSTILE_SITE_KEY=
MELVID_TURNSTILE_SECRET_KEY=
REDIS_URL=
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_actual_key
DEFAULT_FROM_MAIL=Melvid <verify@your-verified-domain.com>
# Optional custom relay endpoint. Resend defaults to its API endpoint.
MELVID_EMAIL_ENDPOINT=
# Legacy MELVID_EMAIL_* names remain supported as migration aliases.

# Paddle one-time credit top-ups (API service only). Leave all blank to retain
# local mock billing. Configure all five values together to enable Paddle.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_CREATOR=
PADDLE_PRICE_STUDIO=
